{
  "name": "crypto-agent",
  "version": "1.0.0",
  "description": "Local crypto market analysis agent using technical indicators",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "schedule": "ts-node src/scheduler.ts",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/__tests__/**/*.test.js\"",
    "lint": "eslint src"
  },
  "keywords": [
    "crypto",
    "trading",
    "technical-analysis"
  ],
  "author": "Sreekanth Varipalli",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sreekanthvaripalli/crypto-agent.git"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "node-cron": "^3.0.3",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.0"
  }
}
